prueba_don <- permu_don |>
get_p_value(
obs_stat= datos_don,
direction="two-sided"
)
prueba_don
permu_rec <- pol |>
specify(Received ~ Ants) |>
hypothesize(null = "independence") |>
generate(reps=1000,type="permute") |>
calculate(
stat = "diff in means",
order = c("0","1")
)
permu_rec |>
visualize()+
labs(y= "Frecuencia", x = "Diferencia Medias Tinta Recibida" , title ="Distribución Nula")+
geom_vline(data = datos_rec, aes(xintercept = stat), color = "black",linetype = "dotted")+
geom_text(data= datos_don, aes(label= "M0-M1",x=stat),y = .1, color = "black", vjust = -1,size=3,hjust=0.5)+
theme(plot.title = element_text(hjust = 0.5))+
scale_color_manual(values = c("Diferencia de Medias Observada" = "black"))
prueba_rec <- permu_rec |>
get_p_value(
obs_stat= datos_rec,
direction="two-sided"
)
prueba_rec
