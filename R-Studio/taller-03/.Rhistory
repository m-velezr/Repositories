group_by(genero) |>
summarise("var"=round(var(hgt,na.rm=TRUE),2),"sd"=round(sd(hgt,na.rm=TRUE),2), "tot" = round(n(),2),"media"= round(mean(hgt),2))
val
ggplot(graf,aes(x=hgt,fill=genero))+
geom_histogram(color="grey")+
facet_wrap(~genero)+
labs(title="Distribución de Altura por Género",x="Altura", y="Cantidad",fill="Género")+
scale_fill_manual(values=c("Hombre"="blue","Mujer"= "pink"))+
theme(plot.title=element_text(size=16, hjust=0.5),
legend.title=element_text(hjust=0.5))+
annotate("text",
x = max(graf$hgt, na.rm = TRUE) * 0.8,
y = max(table(graf$hgt)) * 0.8,
label = paste("Varianza: ", val$varianza[1],
"\nSD: ", val$desviacion[1]),
color = "red", size = 5) +
annotate("text",
x = max(graf$hgt, na.rm = TRUE) * 0.8,
y = max(table(graf$hgt)) * 0.6,
label = paste("Varianza: ", val$varianza[2],
"\nSD: ", val$desviacion[2]),
color = "blue", size = 5)
graf
