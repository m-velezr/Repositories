geom_density(color="grey")+
labs(title="Gráfico de densidad", x= "Altura", y = "Densidad",fill="Género")+
facet_wrap(~genero)+
theme(plot.title=element_text(hjust=0.5),
plot.legend=element_text(hjust=0.5))
