library(dplyr)
library(readr)
datos <- read_table("tortugas.txt")
tabla <- datos |>
group_by(Especie) |>
summarise("Media" = mean( Tem.prom_nidos,na.rm = TRUE ), "Varianza" = var( Tem.prom_nidos,na.rm=TRUE ), "Rango Intercuartil"= IQR( Tem.prom_nidos,na.rm=TRUE ),"Total Nidos" = n())
prim <- quantile(datos$Tem.prom_nidos, probs=c(0.25), na.rm=TRUE)
ult <- quantile(datos$Tem.prom_nidos, probs=c(0.75), na.rm=TRUE)
prim
ult
ult-prim
tabla
