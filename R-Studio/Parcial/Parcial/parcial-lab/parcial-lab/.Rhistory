library(readxl)
library(ggplot2)
library(dplyr)
library(tidyverse)
pokemon <- read_xlsx("datos_pokemon.xlsx")
par(mfrow = c(1,4))
library(readxl)
library(patchwork)
library(ggplot2)
library(dplyr)
library(tidyverse)
pokemon <- read_xlsx("datos_pokemon.xlsx")
par(mfrow = c(1,4))
poder <- pokemon |>
summarise("Media" = mean(pokemon$poder_total,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$poder_total,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$poder_total,na.rm=TRUE)/ mean(pokemon$poder_total,na.rm=TRUE)*100,"Rango Intercuartil" = IQR(pokemon$poder_total,na.rm=TRUE))
ataque  <- pokemon |>
summarise("Media" = mean(pokemon$ataque,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$ataque,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$ataque,na.rm=TRUE)/ mean(pokemon$ataque,na.rm=TRUE) * 100,"Rango Intercuartil" = IQR(pokemon$ataque,na.rm=TRUE))
defensa  <- pokemon |>
summarise("Media" = mean(pokemon$defensa,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$defensa,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$defensa,na.rm=TRUE)/ mean(pokemon$defensa,na.rm=TRUE)*100,"Rango Intercuartil" = IQR(pokemon$defensa,na.rm=TRUE))
velocidad  <- pokemon |>
summarise("Media" = mean(pokemon$velocidad,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$velocidad,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$velocidad,na.rm=TRUE)/ mean(pokemon$velocidad,na.rm=TRUE)*100, "Rango Intercuartil" = IQR(pokemon$velocidad,na.rm=TRUE))
poder
ataque
defensa
velocidad
graf_Poder<-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia del Poder Total", y = "Frecuencia", x= "Poder Total")
graf_Ataque <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia del Ataque",y = "Frecuencia", x= "Ataque")
graf_Defensa <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia de la Defensa",y = "Frecuencia", x= "Defensa")
graf_Velocidad <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia de la Velocidad", y = "Frecuencia", x= "Velocidad")
graf_Poder + graf_Ataque + graf_Defensa+ graf_Velocidad
library(readxl)
library(patchwork)
library(ggplot2)
library(dplyr)
library(tidyverse)
pokemon <- read_xlsx("datos_pokemon.xlsx")
par(mfrow = c(1,4))
poder <- pokemon |>
summarise("Media" = mean(pokemon$poder_total,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$poder_total,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$poder_total,na.rm=TRUE)/ mean(pokemon$poder_total,na.rm=TRUE)*100,"Rango Intercuartil" = IQR(pokemon$poder_total,na.rm=TRUE))
ataque  <- pokemon |>
summarise("Media" = mean(pokemon$ataque,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$ataque,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$ataque,na.rm=TRUE)/ mean(pokemon$ataque,na.rm=TRUE) * 100,"Rango Intercuartil" = IQR(pokemon$ataque,na.rm=TRUE))
defensa  <- pokemon |>
summarise("Media" = mean(pokemon$defensa,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$defensa,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$defensa,na.rm=TRUE)/ mean(pokemon$defensa,na.rm=TRUE)*100,"Rango Intercuartil" = IQR(pokemon$defensa,na.rm=TRUE))
velocidad  <- pokemon |>
summarise("Media" = mean(pokemon$velocidad,na.rm=TRUE), "Desviación Estandar" = sd(pokemon$velocidad,na.rm=TRUE), "Coeficiente de Variación" =sd(pokemon$velocidad,na.rm=TRUE)/ mean(pokemon$velocidad,na.rm=TRUE)*100, "Rango Intercuartil" = IQR(pokemon$velocidad,na.rm=TRUE))
poder
ataque
defensa
velocidad
graf_Poder<-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia del Poder Total", y = "Frecuencia", x= "Poder Total")
graf_Ataque <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia del Ataque",y = "Frecuencia", x= "Ataque")
graf_Defensa <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia de la Defensa",y = "Frecuencia", x= "Defensa")
graf_Velocidad <-ggplot(pokemon, aes(x=poder_total))+
geom_histogram()+
theme_minimal()+
labs(title = "Frecuencia de la Velocidad", y = "Frecuencia", x= "Velocidad")+
theme(plot.title=element_text(hjust=0.5,size=9))
graf_Poder + graf_Ataque + graf_Defensa+ graf_Velocidad
conj <- pokemon |>
filter(tipo == "Grass" | tipo =="Electric"|tipo == "Fire"| tipo =="Water"|tipo=="Poison")
conj
dat <- conj |> drop_na() |>
mutate(legen = case_when(legendario == "FALSE" ~ "No Legendario",
legendario == "TRUE" ~ "Legendario")) |>
summarise(contar = n(), .by = c(tipo, generacion,legen))
grafica <- ggplot(dat,aes(y= contar, x= tipo,fill=generacion))+
geom_col()+
facet_wrap(~legen)+
labs(fill="Generación", x= "Tipo",y="Total")
grafica
prob <- 1-pnorm(600, mean=mean(pokemon$poder_total), sd=sd(pokemon$poder_total))
prob
serp <- read_xlsx("datos_escamas.xlsx")
ser_muj <- serp |>
filter(Sexo == 0)
ser_hom <- serp |>
filter(Sexo == 1)
norm_hem <- shapiro.test(ser_muj$Escamas_Ventrales)
norm_hom <- shapiro.test(ser_hom$Escamas_Ventrales)
norm_hem
norm_hom
varTest<- var.test(ser_muj$Escamas_Ventrales,ser_hom$Escamas_Ventrales)
varTest
test <- t.test(ser_muj$Escamas_Ventrales,ser_hom$Escamas_Ventrales, var.equal = TRUE)
test
graf_hem <- ggplot(ser_muj, aes(x= Escamas_Ventrales))+
geom_histogram()+
theme_minimal()+
labs(title="Frecuencia de Escamas Ventrales Hembras", x="Cantidad Escamas Ventrales",y="Frecuencia")+
theme(plot.title=element_text(hjust=0.5))
graf_hem
graf_hom <- ggplot(ser_hom, aes(x= Escamas_Ventrales))+
geom_histogram()+
theme_minimal()+
labs(title="Frecuencia de Escamas Ventrales Machos", x="Cantidad Escamas Ventrales",y="Frecuencia")+
theme(plot.title=element_text(hjust=0.5))
graf_hom
