labs(y="Área total quemada (ha)",title="Área quemada vs Índices FFMC, DMC e ISI") +
stat_poly_eq(use_label(c("eq","r2","F","p.value", "n")))
graf_tot
graf_part
graf_tot <- ggplot(data=fore_a, aes(x=Valor,y=area))+
geom_point()+
geom_smooth(method=lm)+
theme_linedraw() +
labs(y="Área total quemada (ha)",title="Área quemada vs Índices FFMC, DMC e ISI") +
theme(plot.title=element_text(hjust=0.5))+
stat_poly_eq(use_label(c("eq","r2","F","p.value", "n")))
graf_part<-ggplot(data=fore_a, aes(x=Valor,y=area,color=Variable))+
geom_point()+
geom_smooth(method=lm)+
theme_linedraw() +
labs(y="Área total quemada (ha)",title="Área quemada vs Índices FFMC, DMC e ISI") +
theme(plot.title=element_text(hjust=0.5))+
stat_poly_eq(use_label(c("eq","r2","F","p.value", "n")))
graf_tot
graf_part
