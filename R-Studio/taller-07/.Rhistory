install.packages("ggplot2")
# Cargar librerías
library(ggplot2)
# Crear el gráfico
ggplot(surv, aes(x = Tratamiento, y = Supervivencia, color = as.factor(Veneno), group = Veneno)) +
stat_summary(fun = mean, geom = "line", size = 1) +  # Línea con la media
stat_summary(fun = mean, geom = "point", size = 3) + # Puntos con la media
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno") +
theme_minimal()
ggplot(surv, aes(x = Tratamiento, y = Supervivencia, color = as.factor(Veneno), group = Veneno)) +
stat_summary(fun = mean, geom = "line", size = 1)
stat_summary(fun = mean, geom = "point", size = 3)
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno") +
theme_minimal()
ggplot(surv, aes(x = Tratamiento, y = Supervivencia, color = as.factor(Veneno), group = Veneno)) +
stat_summary(fun = mean, geom = "line", size = 1)
stat_summary(fun = mean, geom = "point", size = 3)
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno") +
theme_minimal()
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno") +
ggplot(surv, aes(x = Tratamiento, y = Supervivencia, color = as.factor(Veneno), group = Veneno)) +
stat_summary(fun = mean, geom = "line", size = 1)
stat_summary(fun = mean, geom = "point", size = 3)
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno")
ggplot(surv, aes(x = Tratamiento, y = Supervivencia, color = as.factor(Veneno), group = Veneno)) +
stat_summary(fun = mean, geom = "line", size = 1)
stat_summary(fun = mean, geom = "point", size = 3)
labs(title = "Interacción entre Veneno y Tratamiento",
x = "Tratamiento", y = "Supervivencia",
color = "Veneno") +
