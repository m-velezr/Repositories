labs( title ="Distribución de la Transformación Logarítmica de la Profundidad del Pecho de las Mujeres")+
theme(plot.title = element_text(hjust=0.5),
plot.margin = margin(t=20, r=10, b= 10, l = 10))
recip
log
norm_recip <- shapiro.test(trans_recip)
norm_log <- shapiro.test(trans_log)
norm_recip
norm_log
